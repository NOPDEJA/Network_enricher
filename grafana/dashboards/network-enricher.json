    {
      "id": 20,
      "type": "table",
      "title": "Answer IPs for $qname (pick one for the panel below)",
      "description": "Candidate answered IPs for the domain variable, most-resolved first. A CDN name answers with several IPs, so the forensic panel below needs one specific value — copy the answer_ip you want into the 'Forensic: answered IP' variable. Timestamps are strings on purpose: a DateTime column makes the ClickHouse plugin render this table as a time series.",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "refId": "A",
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT answer_ip, count() AS resolutions, uniqExact(client_ip) AS clients, toString(min(event_time)) AS first_seen, toString(max(event_time)) AS last_seen FROM dns_events WHERE $__timeFilter(event_time) AND qname = '${qname}' AND answer_ip != '' GROUP BY answer_ip ORDER BY resolutions DESC LIMIT 20"
        }
      ]
    },
    {
      "id": 19,
      "type": "table",
      "title": "Forensic lookup: who resolved $qname → $answer_ip",
      "description": "Set the two dashboard variables above (domain + answered IP), and this panel answers the legal-request scenario: which clients resolved that name to that IP, and when. Client IPs are internal RFC1918 addresses; identity-join returns pseudonymous tokens instead once wired in.",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 56 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "refId": "A",
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT client_ip, count() AS resolutions, toString(min(event_time)) AS first_seen, toString(max(event_time)) AS last_seen FROM dns_events WHERE $__timeFilter(event_time) AND qname = '${qname}' AND answer_ip = '${answer_ip}' GROUP BY client_ip ORDER BY resolutions DESC LIMIT 50"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "ClickHouse on disk (all tables)",
      "description": "Total compressed size of every active part in the enricher database. Read from system.parts, which has no time column — this panel and the rest of the storage row IGNORE the time picker and always show current total size, not size within the selected range.",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 64 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "bytes" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "refId": "A",
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT sum(bytes_on_disk) AS on_disk FROM system.parts WHERE active AND database = currentDatabase()"
        }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "DNS evidence on disk",
      "description": "Compressed size of dns_events alone — the marginal storage cost of the DNS forensic capability.",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 64 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "bytes" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "refId": "A",
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT sum(bytes_on_disk) AS dns_on_disk FROM system.parts WHERE active AND database = currentDatabase() AND table = 'dns_events'"
        }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Bytes per DNS event",
      "description": "Compressed cost of storing one DNS resolution. Multiply by expected resolutions per client per day to size a retention window.",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 64 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "bytes", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "refId": "A",
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT sum(bytes_on_disk) / greatest(sum(rows), 1) AS bytes_per_event FROM system.parts WHERE active AND database = currentDatabase() AND table = 'dns_events'"
        }
      ]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Bytes per enriched flow",
      "description": "Compressed cost of one fully enriched flow record (GeoIP, ASN, tenant, threat columns included). The comparison figure for the DNS cost to its left.",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
